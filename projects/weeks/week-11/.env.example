# Required for transcription + LLM judging. Server-side only; never exposed to the browser.
OPENAI_API_KEY=sk-...

# Optional: model used for speaker naming, question parsing, non-answer judging and the summary.
OPENAI_MODEL=gpt-5.4-mini

# Optional but recommended on a public URL: if set, the app asks for this code
# before it will call any paid API.
ACCESS_CODE=
